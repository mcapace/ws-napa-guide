# Canonical site URL (no trailing slash). Set in Vercel → Production to:
# NEXT_PUBLIC_SITE_URL=https://napatravel.winespectator.com
# Used for metadataBase, Open Graph URL resolution, etc.
#
# Staging (optional): Vercel → Preview → add NEXT_PUBLIC_SITE_URL for the stable
# staging URL, e.g. https://ws-napa-guide-staging.vercel.app
# Preview builds auto-resolve from VERCEL_URL if this is unset (see src/lib/site-url.ts).
NEXT_PUBLIC_SITE_URL=https://napatravel.winespectator.com

# Google Analytics 4 (gtag). Set ONLY on Vercel → Production. Do not set on Preview builds
# and omit locally so events go only from the production site.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HKMJQY8LTC

# Braze — newsletter signup (/api/subscribe). Copy to Vercel; never commit real secrets.
BRAZE_API_KEY=
BRAZE_API_ENDPOINT=https://rest.iad-07.braze.com
BRAZE_NAPA_GUIDE_GROUP_ID=

# ── Itinerary builder: email gate (OTP via SendGrid) + lead storage (Supabase) ──
# Copy to Vercel (Production + Preview). Never commit real secrets.

# SendGrid — sends the 6-digit verification code.
#   SENDGRID_API_KEY needs only the "Mail Send" permission.
#   SENDGRID_FROM_EMAIL must be a verified sender / authenticated domain in SendGrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=restaurant-awards@mail2.winespectator.com
SENDGRID_FROM_NAME=Wine Spectator Napa Valley Guide

# Supabase — stores captured leads (table: public.plan_leads).
#   SUPABASE_URL is the project URL (…supabase.co).
#   SUPABASE_SERVICE_ROLE_KEY is the SECRET service_role key
#   (Supabase dashboard → Settings → API). Server-only; never expose to the client.
SUPABASE_URL=https://ejldicchllevntskspta.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional dedicated HMAC secret for OTP codes (falls back to SENDGRID_API_KEY,
# then SUPABASE_SERVICE_ROLE_KEY). Set a stable random value for best results.
PLAN_OTP_SECRET=
# Staging/local only: echo the OTP in the API response. Never set on Production.
# PLAN_OTP_DEV_ECHO=1

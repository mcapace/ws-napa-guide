# Canonical site URL (no trailing slash). Set in Vercel → Production to:
# NEXT_PUBLIC_SITE_URL=https://napatravel.winespectator.com
# Used for metadataBase, Open Graph URL resolution, etc.
#
# Staging (optional): Vercel → Preview → add NEXT_PUBLIC_SITE_URL for the stable
# staging branch URL, e.g. https://ws-napa-guide-git-staging-michael-capaces-projects-f6224d63.vercel.app
# Preview builds auto-resolve from VERCEL_URL if this is unset (see src/lib/site-url.ts).
NEXT_PUBLIC_SITE_URL=https://napatravel.winespectator.com

# Google Analytics 4 (gtag). Set ONLY on Vercel → Production. Do not set on Preview builds
# and omit locally so events go only from the production site.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HKMJQY8LTC

# Copy to Vercel (Production + Preview). Never commit real secrets.
BRAZE_API_KEY=
BRAZE_API_ENDPOINT=https://rest.iad-07.braze.com
BRAZE_NAPA_GUIDE_GROUP_ID=
